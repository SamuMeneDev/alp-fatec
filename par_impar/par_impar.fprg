    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="varNum" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="True"/>
            <input variable="varNum"/>
            <if expression="varNum % 2 == 0">
                <then>
                    <output expression="&quot;O n&#250;mero &quot;&amp;varNum&amp;&quot; &#233; PAR&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O n&#250;mero &quot;&amp;varNum&amp;&quot; &#233; IMPAR&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
