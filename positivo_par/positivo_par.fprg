<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="positivo_par"/>
        <attribute name="authors" value="Samu Mene"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-23 07:13:27 "/>
        <attribute name="created" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA5LTIzOyIwNzowNjowOSAiOzMxMzY="/>
        <attribute name="edited" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA5LTIzOyIwNzoxMzoyNyAiOzE7MzI0Mg=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="varNum" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="True"/>
            <input variable="varNum"/>
            <if expression="varNum &gt;= 0">
                <then>
                    <output expression="varNum&amp;&quot; &#233; POSITIVO e &quot;" newline="False"/>
                </then>
                <else>
                    <output expression="varNum&amp;&quot; &#233; NEGATIVO e &quot;" newline="False"/>
                    <assign variable="varNum" expression="varNum * -1"/>
                </else>
            </if>
            <if expression="varNum % 2 == 0">
                <then>
                    <output expression="&quot;PAR&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;IMPAR&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
