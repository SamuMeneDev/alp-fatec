    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="varNum" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite um n&#250;mero: &quot;" newline="True"/>
            <input variable="varNum"/>
            <if expression="varNum &gt;= 0">
                <then>
                    <output expression="&quot;O n&#250;mero &quot;&amp;varNum&amp;&quot; &#233; POSITIVO&quot;" newline="True"/>
                </then>
                <else>
                    <output expression="&quot;O n&#250;mero &quot;&amp;varNum&amp;&quot; &#233; NEGATIVO&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
