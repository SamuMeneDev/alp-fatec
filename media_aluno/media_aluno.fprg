<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="media_aluno"/>
        <attribute name="authors" value="Samu Mene"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-23 07:27:54 "/>
        <attribute name="created" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA5LTIzOyIwNzoxODozNiAiOzMxMzk="/>
        <attribute name="edited" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA5LTIzOyIwNzoyNzo1NCAiOzE7MzI0Nw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="varNomeAluno" type="String" array="False" size=""/>
            <declare name="varNota1, varNota2, varMedia" type="Real" array="False" size=""/>
            <output expression="&quot;Digite o nome do aluno: &quot;" newline="True"/>
            <input variable="varNomeAluno"/>
            <output expression="&quot;Digite a nota 1 de &quot;&amp;varNomeAluno" newline="True"/>
            <input variable="varNota1"/>
            <output expression="&quot;Digite a nota 2 de &quot;&amp;varNomeAluno" newline="True"/>
            <input variable="varNota2"/>
            <assign variable="varMedia" expression="(varNota1 + varNota2) / 2"/>
            <output expression="&quot;M&#233;dia de &quot;&amp;varNomeAluno&amp;&quot;: &quot;&amp;varMedia" newline="True"/>
            <if expression="varMedia &lt; 3">
                <then>
                    <output expression="&quot;Reprovado(a)&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="varMedia &lt; 6">
                        <then>
                            <output expression="&quot;Recupera&#231;&#227;o&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Aprovado(a)&quot;" newline="True"/>
                        </else>
                    </if>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
