<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="aumento_salario"/>
        <attribute name="authors" value="Samu Mene"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-09-23 04:45:48 "/>
        <attribute name="created" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA5LTIzOyIwNDozNTozNCAiOzMxMzM="/>
        <attribute name="edited" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA5LTIzOyIwNDo0NTo0OCAiOzE7MzI0Nw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="varNome" type="String" array="False" size=""/>
            <declare name="varSalario, varNovoSalario" type="Real" array="False" size=""/>
            <declare name="varAnosEmpresa" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o nome do fucion&#225;rio: &quot;" newline="True"/>
            <input variable="varNome"/>
            <output expression="&quot;Digite o sal&#225;rio do funcion&#225;rio: R$&quot;" newline="True"/>
            <input variable="varSalario"/>
            <output expression="&quot;Digite quantos anos esse funcion&#225;rio trabalha na empresa: &quot;" newline="True"/>
            <input variable="varAnosEmpresa"/>
            <if expression="varAnosEmpresa == 2">
                <then>
                    <assign variable="varNovoSalario" expression="varSalario + varSalario * 0.02"/>
                </then>
                <else>
                    <if expression="varAnosEmpresa == 5">
                        <then>
                            <assign variable="varNovoSalario" expression="varSalario + varSalario * 0.05"/>
                        </then>
                        <else>
                            <if expression="varAnosEmpresa == 20">
                                <then>
                                    <assign variable="varNovoSalario" expression="varSalario + (varSalario / 6)"/>
                                </then>
                                <else>
                                    <if expression="varAnosEmpresa == 30">
                                        <then>
                                            <assign variable="varNovoSalario" expression="varSalario + varSalario * 0.3"/>
                                        </then>
                                        <else>
                                            <assign variable="varNovoSalario" expression="varSalario"/>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;O novo sal&#225;rio de &quot;&amp;varNome&amp;&quot; ser&#225; de R$ &quot;&amp;varNovoSalario" newline="True"/>
        </body>
    </function>
</flowgorithm>
