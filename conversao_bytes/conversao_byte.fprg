<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="conversao_byte"/>
        <attribute name="authors" value="Aluno"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-27 11:47:14 "/>
        <attribute name="created" value="QWx1bm87MjU3X0RTMi0zMTQ7MjAyNi0wOC0yNjsiMDQ6MTE6NTAgIjsyMzU0"/>
        <attribute name="edited" value="QWx1bm87MjU3X0RTMi0zMTQ7MjAyNi0wOC0yNjsiMDU6NDU6MTMgIjsxOzI0Njk="/>
        <attribute name="edited" value="U2FtdSBNZW5lO0RFU0tUT1AtVlJOMEJWTzsyMDI2LTA4LTI3OyIxMTo0NzoxNCAiOzE7MzI0Mw=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="varValorReal, varValorAproximado, varNum" type="Real" array="False" size=""/>
            <assign variable="varValorReal" expression="0"/>
            <assign variable="varValorAproximado" expression="0"/>
            <declare name="varMultiplo" type="Integer" array="False" size=""/>
            <output expression="&quot;Digite o valor que se deseja converter em Bytes&quot;" newline="True"/>
            <input variable="varNum"/>
            <output expression="&quot;Escolha o multiplo da opera&#231;&#227;o: 1- Byte | 2- KiloByte | 3- MegaByte | 4- GibaBytes | 5- TeraBytes | 6- PetaBytes&quot;" newline="True"/>
            <input variable="varMultiplo"/>
            <if expression="varMultiplo==1">
                <then>
                    <assign variable="varValorAproximado" expression="varNum * 1"/>
                    <assign variable="varValorReal" expression="varNum * 1024"/>
                </then>
                <else>
                    <if expression="varMultiplo==2">
                        <then>
                            <assign variable="varValorAproximado" expression="varNum * 1000"/>
                            <assign variable="varValorReal" expression="varNum * 1024"/>
                        </then>
                        <else>
                            <if expression="varMultiplo==3">
                                <then>
                                    <assign variable="varValorAproximado" expression="varNum * 1000000"/>
                                    <assign variable="varValorReal" expression="varNum * (1024 * 1024)"/>
                                </then>
                                <else>
                                    <if expression="varMultiplo==4">
                                        <then>
                                            <assign variable="varValorAproximado" expression="varNum * 1000000000"/>
                                            <assign variable="varValorAproximado" expression="varNum * (1024 * 1024 * 1024)"/>
                                        </then>
                                        <else>
                                            <if expression="varMultiplo==5">
                                                <then>
                                                    <assign variable="varValorAproximado" expression="varNum * 1000000000000"/>
                                                    <assign variable="varValorReal" expression="varNum * (1024 * 1024 * 1024 * 1024)"/>
                                                </then>
                                                <else>
                                                    <if expression="varMultiplo==6">
                                                        <then>
                                                            <assign variable="varValorAproximado" expression="varNum * 10000000000000000"/>
                                                            <assign variable="varValorReal" expression="varNum * (1024 * 1024 * 1024 * 1024 * 1024)"/>
                                                        </then>
                                                        <else>
                                                            <output expression="&quot;Opera&#231;&#227;o Inv&#225;lida&quot;" newline="True"/>
                                                        </else>
                                                    </if>
                                                </else>
                                            </if>
                                        </else>
                                    </if>
                                </else>
                            </if>
                        </else>
                    </if>
                </else>
            </if>
            <output expression="&quot;O Valor Real convertido em bytes &#233;: &quot; &amp;varValorReal" newline="True"/>
            <output expression="&quot;O Valor Aproximado &#233;: &quot; &amp;varValorAproximado" newline="True"/>
        </body>
    </function>
</flowgorithm>
